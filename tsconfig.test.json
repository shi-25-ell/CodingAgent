{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["bun", "node"],
    "baseUrl": ".",
    "paths": {
      "@coding-agent/model": ["packages/model/src/index.ts"],
      "@coding-agent/model/auth": ["packages/model/src/auth/index.ts"],
      "@coding-agent/model/providers/openai-compatible": [
        "packages/model/src/providers/openai-compatible/index.ts"
      ],
      "@coding-agent/model/providers/anthropic": [
        "packages/model/src/providers/anthropic/index.ts"
      ],
      "@coding-agent/model/testing": ["packages/model/src/testing/index.ts"],
      "@coding-agent/agent": ["packages/agent/src/index.ts"],
      "@coding-agent/agent/session": ["packages/agent/src/session/index.ts"],
      "@coding-agent/agent/context": ["packages/agent/src/context/index.ts"],
      "@coding-agent/agent/testing": ["packages/agent/src/testing/index.ts"],
      "@coding-agent/sqlite": ["packages/sqlite/src/index.ts"],
      "@coding-agent/coding": ["packages/coding/src/index.ts"],
      "@coding-agent/coding/print": ["packages/coding/src/modes/print/index.ts"],
      "@coding-agent/coding/testing": ["packages/coding/src/testing/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"]
}
